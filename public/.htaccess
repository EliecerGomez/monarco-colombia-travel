# ───────────────────────────────────────────────────────────────────────────
# Monarco Viajes — despliegue estático (ColombiaHosting / cPanel · LiteSpeed)
# Este archivo se copia a public_html junto con index.html y /assets.
# ───────────────────────────────────────────────────────────────────────────

# No listar el contenido de los directorios
Options -Indexes

# Servir nuestro index.html en "/" aunque cPanel haya dejado un index.php
# por defecto (que de lo contrario tiene prioridad).
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Forzar HTTPS ──────────────────────────────────────────────────────────
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Canonicalización de dominio ───────────────────────────────────────────
  # Versión canónica: SIN www (coincide con el <link rel="canonical">).
  # Redirige www.monarcovt.com -> monarcovt.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Si prefieres CON www, comenta las 2 líneas de arriba, descomenta estas y
  # cambia el canonical/og:url a https://www.monarcovt.com :
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Fallback SPA ──────────────────────────────────────────────────────────
  # Si la URL corresponde a un archivo o carpeta real (assets), se sirve tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Cualquier otra ruta entrega index.html y el router de React resuelve la vista.
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Compresión ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml \
    font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ── Caché ─────────────────────────────────────────────────────────────────
# Los assets llevan hash en el nombre (cambian al recompilar) -> caché agresiva.
# El HTML nunca se cachea para que los despliegues se vean al instante.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Endurecimiento básico de seguridad
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Tipos MIME (por si el servidor no los define) ───────────────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Página 404 -> entrega la SPA (el router muestra el componente "no encontrado")
ErrorDocument 404 /index.html
